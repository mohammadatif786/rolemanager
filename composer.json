{
    "name": "atif/laravel-role-manager",
    "description": "A Laravel package for managing roles and permissions with full CRUD and UI.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mohammad Atif",
            "email": "mohammadatif24680@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0",
        "spatie/laravel-permission": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Atif\\RoleManager\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Atif\\RoleManager\\RoleManagerServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}